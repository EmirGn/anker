<?xml version="1.0" encoding="utf-8"?>
<!-- Anker syncs with the hub on your own Mac over the local network / Tailscale (plain http). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
